  "welcomeStepsText": {
    "message": "A routine is a list of steps that run one after another. Each step is Focus, Break or Custom, which gives it its colour, and a repeat group runs its steps {minTimes} to {maxTimes} times."
  },
  "welcomeControlsTitle": {
    "message": "Pause, Skip, +5 min"
  },
  "welcomeControlsText": {
    "message": "Pause a step and pick it up later, skip to the next one, or give the current one 5 more minutes."
  },
  "welcomeNextStepTitle": {
    "message": "Start automatically or wait for you"
  },
  "welcomeNextStepText": {
    "message": "When a step ends, the next one starts on its own or waits until you press Start. Choose in Settings."
  },
  "welcomeAlertsTitle": {
    "message": "Notifications, sound and the time on the icon"
  },
  "welcomeAlertsText": {
    "message": "Every step ends with a notification and a short sound, and the notification's buttons pause, skip or start the next step. The toolbar icon shows the minutes left. Settings turns the sound or the time on the icon off."
  },
  "welcomeMinimumTitle": {
    "message": "Steps are at least {seconds} seconds"
  },
  "welcomeMinimumText": {
    "message": "Chrome won't ring an extension's alarm sooner than {seconds} seconds after it's set, so a shorter step would end late."
  },
  "welcomePrivacyTitle": {
    "message": "Privacy"
  },
  "welcomePrivacyText": {
    "message": "No site access, no account, no tracking. Routines and settings sync with Chrome Sync when it's on; the running timer stays on this computer."
  }
